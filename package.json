{
  "name": "@rethunk-ai/ponytail",
  "version": "5.3.3",
  "description": "Lazy senior dev mode for AI agents. The best code is the code you never wrote.",
  "keywords": [
    "opencode-plugin",
    "opencode",
    "ponytail",
    "pi-package",
    "pi",
    "skills",
    "qoder"
  ],
  "license": "MIT",
  "author": {
    "name": "Dietrich Gebert",
    "url": "https://github.com/DietrichGebert"
  },
  "homepage": "https://github.com/Rethunk-AI/ponytail",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rethunk-AI/ponytail.git"
  },
  "bugs": {
    "url": "https://github.com/Rethunk-AI/ponytail/issues"
  },
  "main": "./.opencode/plugins/ponytail.ts",
  "exports": {
    ".": "./.opencode/plugins/ponytail.ts",
    "./plugin": "./.opencode/plugins/ponytail.ts"
  },
  "files": [
    "AGENTS.md",
    "hooks/",
    "skills/",
    ".opencode/",
    ".qoder/",
    ".qoder-plugin/",
    "pi-extension/",
    "!pi-extension/test/",
    "scripts/uninstall.ts",
    "scripts/cursor-hooks.ts",
    "LICENSE"
  ],
  "scripts": {
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "typecheck": "tsc -b --noEmit --pretty false",
    "knip": "knip",
    "check:rules": "bun scripts/check-rule-copies.ts",
    "check:versions": "bun scripts/check-versions.ts",
    "test": "bun test",
    "ci": "bun run lint && bun run typecheck && bun run knip && bun run check:rules && bun run check:versions && bun run test"
  },
  "pi": {
    "extensions": [
      "./pi-extension/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/bun": "^1.4.4",
    "knip": "^6.45.0",
    "typescript": "^7.0.2"
  }
}
